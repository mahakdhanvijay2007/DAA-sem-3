#include<stdio.h>
#include<string.h>
#include<stdbool.h>
#define MAX_LENGTH 100

int max(int a, int b){if(a>b){return a;}else{return b;}}

int lcsOf3(char X[], char Y[], char Z[], int m, int n, int o){

    // Strip trailing newline or carriage return characters from fgets
    while (m > 0 && (X[m - 1] == '\n' || X[m - 1] == '\r')) m--;
    while (n > 0 && (Y[n - 1] == '\n' || Y[n - 1] == '\r')) n--;
    while (o > 0 && (Z[o - 1] == '\n' || Z[o - 1] == '\r')) o--;

    // Create a 3D table to store lengths of longest common subsequences
    int dp[m + 1][n + 1][o + 1];

    // Build the matrix bottom-up
    for (int i = 0; i <= m; i++) {
        for (int j = 0; j <= n; j++) {
            for (int k = 0; k <= o; k++) {
                if (i == 0 || j == 0 || k == 0) {
                    dp[i][j][k] = 0; // Base case: empty strings
                } 
                else if (X[i - 1] == Y[j - 1] && X[i - 1] == Z[k - 1]) {
                    dp[i][j][k] = dp[i - 1][j - 1][k - 1] + 1; // Match found
                } 
                else {
                    // Match not found, take the maximum of three possible directions
                    dp[i][j][k] = max(max(dp[i - 1][j][k], dp[i][j - 1][k]), dp[i][j][k - 1]);
                }
            }
        }
    }

    // Return the final result
}
