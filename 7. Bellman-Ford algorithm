#include <stdio.h>
#include <limits.h>

#define MAXV 1005
#define MAXE 10005
#define INF 1000000000

struct Edge {
    int u, v, w;
};

struct Edge edges[MAXE];
int dist[MAXV], parent[MAXV];

void printPath(int v) {
    if (parent[v] == -1) {
        printf("%d", v);
        return;
    }
    printPath(parent[v]);
    printf("->%d", v);
}

int main() {
    int V, E, src;
    scanf("%d", &V);
    scanf("%d", &E);

    for (int i = 0; i < E; i++) {
        scanf("%d %d %d", &edges[i].u, &edges[i].v, &edges[i].w);
    }

    scanf("%d", &src);

    for (int i = 1; i <= V; i++) {
        dist[i] = INF;
}  
