#include <stdio.h>

#define MAX 100

int main() {
    int m1, n1;
    if (scanf("%d %d", &m1, &n1) != 2) return 0;

    int A[MAX][MAX];
    for (int i = 0; i < m1; i++) {
        for (int j = 0; j < n1; j++) {
            if (scanf("%d", &A[i][j]) != 1) return 0;
        }
    }

    int m2, n2;
    if (scanf("%d %d", &m2, &n2) != 2) return 0;

    if (n1 != m2) {
        printf("Invalid input\n");
        return 0;
    }

    int B[MAX][MAX];
    for (int i = 0; i < m2; i++) {
        for (int j = 0; j < n2; j++) {
            if (scanf("%d", &B[i][j]) != 1) return 0;
        }
    }

    int C[MAX][MAX] = {0};

    for (int i = 0; i < m1; i++) {
        for (int j = 0; j < n2; j++) {
            for (int k = 0; k < n1; k++) {
                C[i][j] += A[i][k] * B[k][j];
